cabal-version: 3.0
name:          layoutz
version:       0.4.0.0
synopsis:      Simple, beautiful CLI output
description:   Zero-dep, compositional terminal output
homepage:      https://github.com/mattlianje/layoutz
bug-reports:   https://github.com/mattlianje/layoutz/issues
license:       Apache-2.0
license-file:  LICENSE
author:        Matthieu Court
maintainer:    matthieu.court@protonmail.com
copyright:     2025 Matthieu Court
category:      Text
build-type:    Simple

extra-source-files:
    README.md
    CHANGELOG.md
    pix/*.png

source-repository head
  type: git
  location: https://github.com/mattlianje/layoutz
  subdir: hs

library
  exposed-modules:     Layoutz
  build-depends:       base >= 4.7 && < 5
                     , text >= 2.1.2 && < 2.2
                     , containers >= 0.5 && < 0.9
                     , directory >= 1.2 && < 1.4
  if !os(windows)
    build-depends:     unix >= 2.7 && < 2.9
  hs-source-dirs:      .
  default-language:    Haskell2010
  ghc-options:         -Wall

executable ask-demo
  main-is:             AskDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable inline-bar
  main-is:             InlineBar.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable inline-loading-demo
  main-is:             InlineLoadingDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable click-demo
  main-is:             ClickDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable fill-demo
  main-is:             FillDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable focus-demo
  main-is:             FocusDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable napkin-demo
  main-is:             NapkinDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable showcase-app
  main-is:             ShowcaseApp.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable zoom-demo
  main-is:             ZoomDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
                     , containers
                     , array
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall -O2

executable raymarcher
  main-is:             RayMarcher.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall -O2

executable counter-demo
  main-is:             CounterDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable readme-demo
  main-is:             ReadmeDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable simple-game
  main-is:             SimpleGame.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable spinner-demo
  main-is:             SpinnerDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

executable task-list-demo
  main-is:             TaskListDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , containers
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite layoutz-tests
  type:                exitcode-stdio-1.0
  main-is:             Test.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , text
                     , tasty >= 1.4
                     , tasty-hunit >= 0.10
  hs-source-dirs:      test
  default-language:    Haskell2010
  ghc-options:         -Wall

-- layoutz vs Bubble Tea, Brick and ratatui: `make bench`. Linux only.
benchmark layoutz-bench
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  other-modules:       Dashboard
                     , Pty
                     , Report
  hs-source-dirs:      bench
  c-sources:           bench/cbits/pty.c
  extra-libraries:     util
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , bytestring
                     , directory
                     , filepath
                     , process
                     , unix
  default-language:    Haskell2010
  ghc-options:         -Wall -O2
  if !os(linux)
    buildable:         False

executable tile-demo
  main-is:             TileDemo.hs
  build-depends:       base >= 4.7 && < 5
                     , layoutz
                     , containers
                     , process
  hs-source-dirs:      examples
  default-language:    Haskell2010
  ghc-options:         -Wall -O2 -threaded
